@model IEnumerable<Deployguard.Models.SecretScan>

@{
    ViewData["Title"] = "Scan History";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-clock-history me-2"></i>
                Scan History
            </h1>
            <p class="text-muted mb-0">
                View all your previous repository security scans.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Repository"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Repositories
            </a>
        </div>
    </div>


    <!-- Summary -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">
                        Total Scans
                    </div>

                    <div class="fs-3 fw-bold">
                        @Model.Count()
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">
                        Completed
                    </div>

                    <div class="fs-3 fw-bold text-success">
                        @Model.Count(s => s.Status == "Completed")
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">
                        Failed
                    </div>

                    <div class="fs-3 fw-bold text-danger">
                        @Model.Count(s => s.Status == "Failed")
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">
                        Secrets Found
                    </div>

                    <div class="fs-3 fw-bold text-warning">
                        @Model.Sum(s => s.SecretsFound)
                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- Scan History -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="mb-1 fw-bold">
                        <i class="bi bi-shield-check me-2"></i>
                        Previous Scans
                    </h5>

                    <small class="text-muted">
                        Your repository security scan activity
                    </small>
                </div>

            </div>
        </div>


        @if (!Model.Any())
        {
            <div class="card-body text-center py-5">

                <div class="mb-3">
                    <i class="bi bi-search fs-1 text-muted"></i>
                </div>

                <h5 class="fw-bold">
                    No scans yet
                </h5>

                <p class="text-muted mb-4">
                    You haven't performed any repository security scans.
                </p>

                <a asp-controller="Repository"
                   asp-action="Index"
                   class="btn btn-primary">
                    <i class="bi bi-github me-1"></i>
                    View Repositories
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Repository</th>
                            <th>Status</th>
                            <th>Files</th>
                            <th>Secrets</th>
                            <th>Started</th>
                            <th>Completed</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var scan in Model)
                        {
                            <tr>

                                <!-- ID -->
                                <td>
                                    <span class="fw-semibold">
                                        #@scan.Id
                                    </span>
                                </td>


                                <!-- Repository -->
                                <td>
                                    @if (scan.Repository != null)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fs-6" title="@scan.Repository.Provider">
                                                <partial name="_ProviderIcon" model="scan.Repository.Provider" />
                                            </span>
                                            <span class="fw-semibold">
                                                @scan.Repository.Name
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Repository unavailable
                                        </span>
                                    }
                                </td>


                                <!-- Status -->
                                <td>

                                    @if (scan.Status == "Completed")
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Completed
                                        </span>
                                    }
                                    else if (scan.Status == "Failed")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Failed
                                        </span>
                                    }
                                    else if (scan.Status == "Running")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-hourglass-split me-1"></i>
                                            Running
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @scan.Status
                                        </span>
                                    }

                                </td>


                                <!-- Files -->
                                <td>
                                    <span class="fw-semibold">
                                        @scan.FilesScanned
                                    </span>
                                </td>


                                <!-- Secrets -->
                                <td>

                                    @if (scan.SecretsFound > 0)
                                    {
                                        <span class="badge bg-danger">
                                            @scan.SecretsFound
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            0
                                        </span>
                                    }

                                </td>


                                <!-- Started -->
                                <td>
                                    <div data-utc="@scan.StartedAt.ToString("o")" data-utc-format="date">
                                        @scan.StartedAt.ToString("dd MMM yyyy")
                                    </div>

                                    <small class="text-muted" data-utc="@scan.StartedAt.ToString("o")" data-utc-format="time">
                                        @scan.StartedAt.ToString("hh:mm tt")
                                    </small>
                                </td>


                                <!-- Completed -->
                                <td>
                                    @if (scan.CompletedAt.HasValue)
                                    {
                                        <div data-utc="@scan.CompletedAt.Value.ToString("o")" data-utc-format="date">
                                            @scan.CompletedAt.Value.ToString("dd MMM yyyy")
                                        </div>

                                        <small class="text-muted" data-utc="@scan.CompletedAt.Value.ToString("o")" data-utc-format="time">
                                            @scan.CompletedAt.Value.ToString("hh:mm tt")
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }
                                </td>


                                <!-- Action -->
                                <td class="text-end">

                                    <a asp-controller="Scan"
                                       asp-action="Details"
                                       asp-route-id="@scan.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye me-1"></i>
                                        View Details

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>