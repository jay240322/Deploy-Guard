@{
    ViewData["Title"] = "Create Account - DeployGuard";
    ViewData["HideNavbar"] = true;
    ViewData["HideFooter"] = true;
}

<div class="auth-wrapper min-vh-100 d-flex align-items-center justify-content-center py-2 px-3">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-8 col-xl-7" style="max-width: 660px;">
                <div class="card auth-card border-0 shadow-lg rounded-4 overflow-hidden">

                    <!-- Header with App Logo -->
                    <div class="auth-card-header text-center pt-4 pb-2 px-4">
                        <div class="brand-icon-wrapper mx-auto mb-2 d-flex align-items-center justify-content-center shadow-sm">
                            <i class="bi bi-person-plus-fill text-primary fs-3"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-0">Create an Account</h4>
                        <p class="text-muted small mb-0" style="font-size: 0.85rem;">
                            Join DeployGuard to inspect repositories, trace pipelines & secure secrets
                        </p>
                    </div>

                    <div class="card-body p-3 p-md-4 pt-2">

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger d-flex align-items-center gap-2 border-0 shadow-sm rounded-3 py-1 px-3 mb-2" role="alert">
                                <i class="bi bi-exclamation-triangle-fill fs-6 flex-shrink-0"></i>
                                <div class="small fw-medium">@ViewBag.Error</div>
                            </div>
                        }

                        <form asp-controller="Account" asp-action="Register" method="post" autocomplete="on">
                            @Html.AntiForgeryToken()

                            <!-- Full Name Input -->
                            <div class="mb-2">
                                <label class="form-label small fw-semibold text-dark mb-1">Full Name</label>
                                <div class="input-group auth-input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted ps-3">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <input type="text"
                                           name="fullName"
                                           class="form-control border-start-0 ps-2"
                                           placeholder="John Doe"
                                           required
                                           autofocus />
                                </div>
                            </div>

                            <!-- Username Input -->
                            <div class="mb-2">
                                <label class="form-label small fw-semibold text-dark mb-1">Username</label>
                                <div class="input-group auth-input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted ps-3">
                                        <i class="bi bi-at"></i>
                                    </span>
                                    <input type="text"
                                           name="username"
                                           class="form-control border-start-0 ps-2"
                                           placeholder="johndoe"
                                           required />
                                </div>
                            </div>

                            <!-- Email Input -->
                            <div class="mb-2">
                                <label class="form-label small fw-semibold text-dark mb-1">Email Address</label>
                                <div class="input-group auth-input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted ps-3">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input type="email"
                                           name="email"
                                           class="form-control border-start-0 ps-2"
                                           placeholder="name@example.com"
                                           required />
                                </div>
                            </div>

                            <!-- Password Input -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-dark mb-1">Password</label>
                                <div class="input-group auth-input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted ps-3">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <input type="password"
                                           id="registerPassword"
                                           name="password"
                                           class="form-control border-start-0 border-end-0 ps-2"
                                           placeholder="••••••••••••"
                                           required />
                                    <button class="btn btn-light border border-start-0 text-muted pe-3 toggle-password-btn"
                                            type="button"
                                            onclick="togglePasswordVisibility('registerPassword', this)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-primary auth-submit-btn w-100 py-2 fs-6 fw-semibold rounded-3 shadow-sm mb-2">
                                <i class="bi bi-person-check me-1"></i> Register Account
                            </button>
                        </form>

                        <!-- Divider with OR -->
                        <div class="d-flex align-items-center my-2">
                            <hr class="flex-grow-1 my-0 text-muted opacity-25">
                            <span class="px-2 text-muted small" style="font-size: 0.75rem; font-weight: 500;">OR</span>
                            <hr class="flex-grow-1 my-0 text-muted opacity-25">
                        </div>

                        <!-- Google Sign In Button -->
                        <button type="button" id="googleSignUpBtn" class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-3 shadow-sm bg-white border text-dark fw-semibold mb-2" style="font-size: 0.88rem; transition: all 0.2s ease;">
                            <svg width="18" height="18" viewBox="0 0 48 48">
                                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                            </svg>
                            <span>Sign up with Google</span>
                        </button>

                        <!-- Switch to Login -->
                        <div class="text-center mt-2 pt-2 border-top">
                            <span class="text-muted small">Already have an account?</span>
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="text-primary text-decoration-none fw-semibold small ms-1">
                                Sign in here
                            </a>
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body, html {
        height: 100%;
    }

    .auth-wrapper {
        min-height: 100vh;
        background: radial-gradient(circle at 50% 30%, rgba(37, 99, 235, 0.06) 0%, rgba(248, 250, 252, 1) 100%);
    }

    .auth-card {
        background: #ffffff;
        box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.07), 0 0 15px rgba(0, 0, 0, 0.02) !important;
        border: 1px solid rgba(226, 232, 240, 0.8) !important;
    }

    .brand-icon-wrapper {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(37, 99, 235, 0.1);
        border: 1px solid rgba(37, 99, 235, 0.2);
    }

    .auth-input-group .form-control {
        border-color: #e2e8f0;
        font-size: 0.9rem;
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
    }

    .auth-input-group .input-group-text {
        border-color: #e2e8f0;
        color: #64748b;
        font-size: 0.9rem;
    }

    .auth-input-group .form-control:focus {
        border-color: #3b82f6;
        box-shadow: none;
    }

    .auth-submit-btn {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        border: none;
        padding-top: 0.55rem;
        padding-bottom: 0.55rem;
        transition: all 0.25s ease;
    }

    .auth-submit-btn:hover {
        background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25) !important;
    }

    #googleSignUpBtn:hover {
        background-color: #f8fafc !important;
        border-color: #cbd5e1 !important;
        transform: translateY(-1px);
    }
</style>

<script>
    function togglePasswordVisibility(inputId, btn) {
        var input = document.getElementById(inputId);
        var icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        }
    }
</script>

<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getAuth, GoogleAuthProvider, signInWithPopup } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";

    const firebaseConfig = {
      apiKey: "AIzaSyCFN3Bu0Kc0s12Q61I89HgRcpN-uY_dh8I",
      authDomain: "deploy-guard-7ee2b.firebaseapp.com",
      projectId: "deploy-guard-7ee2b",
      storageBucket: "deploy-guard-7ee2b.firebasestorage.app",
      messagingSenderId: "895345541540",
      appId: "1:895345541540:web:5c75ffbac9bd3949b9c131"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const provider = new GoogleAuthProvider();

    const googleBtn = document.getElementById("googleSignUpBtn");
    if (googleBtn) {
        googleBtn.addEventListener("click", async () => {
            try {
                googleBtn.disabled = true;
                googleBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Connecting...`;
                
                const result = await signInWithPopup(auth, provider);
                const user = result.user;
                
                const response = await fetch('@Url.Action("GoogleLogin", "Account")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        email: user.email,
                        fullName: user.displayName,
                        googleUid: user.uid
                    })
                });

                const data = await response.json();
                if (data.success) {
                    window.location.href = data.redirectUrl || '@Url.Action("Index", "Home")';
                } else {
                    alert(data.message || 'Google sign-up failed.');
                    resetGoogleBtn();
                }
            } catch (err) {
                console.error("Firebase auth error:", err);
                if (err.code !== 'auth/popup-closed-by-user') {
                    alert('Google Sign-Up: ' + (err.message || err.code));
                }
                resetGoogleBtn();
            }
        });
    }

    function resetGoogleBtn() {
        if (!googleBtn) return;
        googleBtn.disabled = false;
        googleBtn.innerHTML = `
            <svg width="18" height="18" viewBox="0 0 48 48">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            </svg>
            <span>Sign up with Google</span>
        `;
    }
</script>