@{
    var currentCtrl = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";

    var isAdminDashboard = currentCtrl.Equals("Admin", StringComparison.OrdinalIgnoreCase) &&
                           (currentAct.Equals("Index", StringComparison.OrdinalIgnoreCase) || currentAct.Equals("Dashboard", StringComparison.OrdinalIgnoreCase));
    var isRepository = currentCtrl.Equals("Repository", StringComparison.OrdinalIgnoreCase);
    var isScan = currentCtrl.Equals("Scan", StringComparison.OrdinalIgnoreCase);
}

<nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow sticky-top mb-3 py-2">

    <div class="container-fluid">

        <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
           asp-controller="Admin"
           asp-action="Index">
            <i class="bi bi-shield-shaded text-danger"></i>
            DeployGuard Admin
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#adminNavbar"
                aria-controls="adminNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse" id="adminNavbar">

            <ul class="navbar-nav me-auto">

                @if (!isAdminDashboard)
                {
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Admin"
                           asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
                        </a>
                    </li>
                }

                @if (!isRepository)
                {
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Repository"
                           asp-action="Index">
                            <i class="bi bi-folder me-1"></i> Repositories
                        </a>
                    </li>
                }

                @if (!isScan)
                {
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Scan"
                           asp-action="History">
                            <i class="bi bi-shield-check me-1"></i> Scans
                        </a>
                    </li>
                }

            </ul>

            <ul class="navbar-nav align-items-center gap-2">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item text-light small d-none d-md-inline me-2">
                        <span class="badge bg-danger me-1">ADMIN</span> @User.Identity.Name
                    </li>
                }

                <li class="nav-item">

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                        </button>

                    </form>

                </li>

            </ul>

        </div>

    </div>

</nav>