@{
    var currentCtrl = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";

    var isAdminDashboard = currentCtrl.Equals("Admin", StringComparison.OrdinalIgnoreCase) &&
                           (currentAct.Equals("Index", StringComparison.OrdinalIgnoreCase) || currentAct.Equals("Dashboard", StringComparison.OrdinalIgnoreCase));
    var isUsersPage = currentCtrl.Equals("Admin", StringComparison.OrdinalIgnoreCase) &&
                      currentAct.Equals("Users", StringComparison.OrdinalIgnoreCase);
    var isReportPage = currentCtrl.Equals("Admin", StringComparison.OrdinalIgnoreCase) &&
                       (currentAct.Equals("Report", StringComparison.OrdinalIgnoreCase) || currentAct.Equals("ExportReportPdf", StringComparison.OrdinalIgnoreCase));
}

<nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-0 py-1">

    <div class="container-fluid px-3 px-md-4 px-xl-5 d-flex align-items-center">

        <a class="navbar-brand fw-bold d-flex align-items-center gap-2 py-0"
           asp-controller="Admin"
           asp-action="Index">
            <img src="~/images/logo.png" alt="DeployGuard Admin" class="brand-logo rounded-circle shadow-xs" width="30" height="30" />
            <span>DeployGuard Admin</span>
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#adminNavbar"
                aria-controls="adminNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse align-items-center" id="adminNavbar">

            <ul class="navbar-nav me-auto gap-1 align-items-center">

                <li class="nav-item">
                    <a class="nav-link px-3 py-1.5 rounded-3 d-flex align-items-center gap-2 @(isAdminDashboard ? "active-nav-link" : "")"
                       asp-controller="Admin"
                       asp-action="Index">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link px-3 py-1.5 rounded-3 d-flex align-items-center gap-2 @(isUsersPage ? "active-nav-link" : "")"
                       asp-controller="Admin"
                       asp-action="Users">
                        <i class="bi bi-people"></i>
                        <span>Users</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link px-3 py-1.5 rounded-3 d-flex align-items-center gap-2 @(isReportPage ? "active-nav-link" : "")"
                       asp-controller="Admin"
                       asp-action="Report">
                        <i class="bi bi-activity"></i>
                        <span>Scan Usage & Reports</span>
                    </a>
                </li>

            </ul>

            <ul class="navbar-nav align-items-center gap-2">

                <!-- Theme Toggle Button -->
                <li class="nav-item me-1">
                    <button type="button"
                            class="btn btn-outline-light btn-sm d-flex align-items-center justify-content-center p-2 rounded-circle theme-toggle-btn"
                            id="themeToggleBtn"
                            title="Toggle Light / Dark Mode"
                            aria-label="Toggle Theme">
                        <i class="bi bi-moon-stars-fill theme-icon-dark"></i>
                        <i class="bi bi-sun-fill theme-icon-light d-none text-warning"></i>
                    </button>
                </li>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item text-light d-flex align-items-center gap-2 me-2 px-2 py-1 user-profile-badge">
                        <span class="badge bg-danger">ADMIN</span>
                        <div class="d-flex align-items-center gap-1">
                            <i class="bi bi-person-circle fs-5 text-danger-subtle"></i>
                            <span class="fw-medium">@User.Identity.Name</span>
                        </div>
                    </li>
                }

                <li class="nav-item">
                    <button type="button"
                            class="btn btn-outline-danger btn-sm px-3"
                            data-bs-toggle="modal"
                            data-bs-target="#logoutConfirmModal">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </button>
                </li>

            </ul>

        </div>

    </div>

</nav>