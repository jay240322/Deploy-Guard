@{
    var currentCtrl = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";

    var isHome = currentCtrl.Equals("Home", StringComparison.OrdinalIgnoreCase) &&
                 (currentAct.Equals("Index", StringComparison.OrdinalIgnoreCase) || currentAct.Equals("Dashboard", StringComparison.OrdinalIgnoreCase));
    var isRepository = currentCtrl.Equals("Repository", StringComparison.OrdinalIgnoreCase);
    var isScan = currentCtrl.Equals("Scan", StringComparison.OrdinalIgnoreCase);
}

<nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow sticky-top mb-3 py-2">

    <div class="container-fluid">

        <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
           asp-controller="Home"
           asp-action="Index">
            <i class="bi bi-shield-lock-fill text-primary"></i>
            DeployGuard
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#userNavbar"
                aria-controls="userNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse" id="userNavbar">

            <ul class="navbar-nav me-auto gap-1">

                <li class="nav-item">
                    <a class="nav-link px-3 py-2 rounded-3 d-flex align-items-center gap-2 @(isHome ? "active-nav-link" : "")"
                       asp-controller="Home"
                       asp-action="Index">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link px-3 py-2 rounded-3 d-flex align-items-center gap-2 @(isRepository ? "active-nav-link" : "")"
                       asp-controller="Repository"
                       asp-action="Index">
                        <i class="bi bi-folder"></i>
                        <span>Repositories</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link px-3 py-2 rounded-3 d-flex align-items-center gap-2 @(isScan ? "active-nav-link" : "")"
                       asp-controller="Scan"
                       asp-action="History">
                        <i class="bi bi-shield-check"></i>
                        <span>Scan History</span>
                    </a>
                </li>

            </ul>

            <ul class="navbar-nav align-items-center gap-2">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item text-light d-flex align-items-center gap-1 me-2 px-2 py-1 user-profile-badge">
                        <i class="bi bi-person-circle fs-5 text-primary"></i>
                        <span class="fw-medium">@User.Identity.Name</span>
                    </li>
                }

                <li class="nav-item">
                    <button type="button"
                            class="btn btn-outline-danger btn-sm px-3"
                            data-bs-toggle="modal"
                            data-bs-target="#logoutConfirmModal">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </button>
                </li>

            </ul>

        </div>

    </div>

</nav>