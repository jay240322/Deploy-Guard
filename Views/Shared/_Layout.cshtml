<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - DeployGuard</title>

    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="apple-touch-icon" href="~/images/logo.png" />

    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Deployguard.styles.css"
          asp-append-version="true" />

    <script>
        (function() {
            var savedTheme = localStorage.getItem('deployguard-theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
</head>

<body>

@{
    var currentCtrl = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
    var isAuthPage = currentCtrl.Equals("Account", StringComparison.OrdinalIgnoreCase)
                  || (currentCtrl.Equals("Admin", StringComparison.OrdinalIgnoreCase) && currentAct.Equals("Login", StringComparison.OrdinalIgnoreCase));
    var hideNavbar = (ViewData["HideNavbar"] as bool? == true) || isAuthPage;
    var hideFooter = (ViewData["HideFooter"] as bool? == true) || isAuthPage;
}

@if (!hideNavbar)
{
    <header class="sticky-top">
        @if (User.Identity?.IsAuthenticated != true)
        {
            <partial name="_GuestNavbar" />
        }
        else if (User.IsInRole("Admin"))
        {
            <partial name="_AdminNavbar" />
        }
        else
        {
            <partial name="_UserNavbar" />
        }
    </header>
}

<!-- PAGE CONTENT -->

@if (isAuthPage || (ViewData["HideNavbar"] as bool? == true && ViewData["HideFooter"] as bool? == true))
{
    <main role="main" class="auth-main-wrapper">
        @RenderBody()
    </main>
}
else if (hideFooter)
{
    <main role="main">
        @RenderBody()
    </main>
}
else
{
    <div class="container-fluid px-3 px-md-4 px-xl-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="border-top footer text-muted">
        <div class="container-fluid px-3 px-md-4 px-xl-5 d-flex align-items-center gap-2">
            <img src="~/images/logo.png" alt="DeployGuard" width="18" height="18" class="rounded-circle" />
            <span>&copy; 2026 <strong>DeployGuard</strong> -</span>
            <a asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>
}

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Global Logout Confirmation Modal -->
    <div class="modal fade"
         id="logoutConfirmModal"
         tabindex="-1"
         aria-labelledby="logoutConfirmModalLabel"
         aria-hidden="true"
         style="z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-bottom bg-light">
                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2"
                        id="logoutConfirmModalLabel">
                        <img src="~/images/logo.png" alt="DeployGuard" width="22" height="22" class="rounded-circle" />
                        Confirm Logout
                    </h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-1 fs-6">
                        Are you sure you want to end your session and log out of <img src="~/images/logo.png" alt="DeployGuard" width="18" height="18" class="rounded-circle align-text-top" /> <strong>DeployGuard</strong>?
                    </p>
                    <p class="text-muted small mb-0">
                        You will be signed out and redirected to the login page.
                    </p>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="btn btn-danger fw-semibold px-3">
                            <i class="bi bi-box-arrow-right me-1"></i> Yes, Log Out
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- Global Interactive Processing Loader Overlay -->
<div id="globalLoaderOverlay" class="global-loader-overlay d-none" aria-live="polite" aria-label="Loading content">
    <div class="global-loader-card">
        <div class="spinner-border text-primary global-loader-spinner" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div class="global-loader-text mt-3 fw-semibold">
            <span id="globalLoaderText">Processing request...</span>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true">
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>