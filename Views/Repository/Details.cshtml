@model Deployguard.Models.Repository

@{
    ViewData["Title"] = "Repository Details";
    var hasBeenScanned = Model.LastScannedAt.HasValue || ViewBag.LatestScan != null;
}

<div class="py-3">

    <!-- Top Header & Navigation / Repository Management Actions -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="fs-4 d-inline-flex align-items-center" title="@Model.Provider">
                    <partial name="_ProviderIcon" model="Model.Provider" />
                </span>
                <h2 class="fw-bold mb-0">@Model.Name</h2>
            </div>
            <p class="text-muted mb-0">
                <i class="bi bi-info-circle me-1"></i> Repository details and CI/CD security status
            </p>
        </div>

        <!-- Management Actions: Back, Edit, Delete -->
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (User.IsInRole("Admin"))
            {
                <!-- Back to Platform Report for Admin -->
                <a asp-controller="Admin"
                   asp-action="Report"
                   class="btn btn-outline-secondary d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-arrow-left"></i>
                    <span>Back to Report</span>
                </a>
            }
            else
            {
                <!-- Back to Repositories for Regular Users -->
                <a asp-controller="Repository"
                   asp-action="Index"
                   class="btn btn-outline-secondary d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-arrow-left"></i>
                    <span>Back to Repositories</span>
                </a>

                <!-- Edit Repository -->
                <a asp-controller="Repository"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning text-dark fw-semibold d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-pencil-square"></i>
                    <span>Edit</span>
                </a>

                <!-- Delete Repository -->
                <button type="button"
                        class="btn btn-outline-danger d-flex align-items-center gap-1 shadow-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#deleteRepositoryModal">
                    <i class="bi bi-trash3"></i>
                    <span>Delete</span>
                </button>
            }
        </div>
    </div>

    <!-- Repository Information Card (Repo Box) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden">
        <div class="card-header bg-light border-bottom py-3 px-4">
            <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-journal-code text-primary"></i>
                Repository Metadata & Configuration
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">
                <!-- Repository Name -->
                <div class="col-sm-6 col-lg-4">
                    <div class="text-muted small fw-medium mb-1">
                        <i class="bi bi-tag me-1"></i> Repository Name
                    </div>
                    <div class="fw-bold fs-6 text-dark">
                        @Model.Name
                    </div>
                </div>

                <!-- Provider -->
                <div class="col-sm-6 col-lg-4">
                    <div class="text-muted small fw-medium mb-1">
                        <i class="bi bi-hdd-network me-1"></i> Provider
                    </div>
                    <div class="fs-4">
                        <partial name="_ProviderIcon" model="Model.Provider" />
                    </div>
                </div>

                <!-- Language -->
                <div class="col-sm-6 col-lg-4">
                    <div class="text-muted small fw-medium mb-1">
                        <i class="bi bi-code-slash me-1"></i> Primary Language
                    </div>
                    <div class="fw-semibold text-dark">
                        @(string.IsNullOrEmpty(Model.Language) ? "Pending / Unknown" : Model.Language)
                    </div>
                </div>

                <!-- Repository URL -->
                <div class="col-12 col-lg-8">
                    <div class="text-muted small fw-medium mb-1">
                        <i class="bi bi-link-45deg me-1"></i> Repository URL
                    </div>
                    <div>
                        <a href="@Model.RepoUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="text-primary text-decoration-none fw-medium text-break">
                            <i class="bi bi-box-arrow-up-right me-1 small"></i> @Model.RepoUrl
                        </a>
                    </div>
                </div>

                <!-- Default Branch -->
                <div class="col-sm-6 col-lg-4">
                    <div class="text-muted small fw-medium mb-1">
                        <i class="bi bi-bezier2 me-1"></i> Default Branch
                    </div>
                    <div>
                        <span class="badge bg-dark-subtle text-dark border">
                            <i class="bi bi-git me-1"></i> @(string.IsNullOrEmpty(Model.DefaultBranch) ? "main" : Model.DefaultBranch)
                        </span>
                    </div>
                </div>

                <!-- Owner -->
                <div class="col-sm-6 col-lg-4">
                    <div class="text-muted small fw-medium mb-1">
                        <i class="bi bi-person me-1"></i> Owner
                    </div>
                    <div class="fw-medium text-dark">
                        @(string.IsNullOrEmpty(Model.Owner) ? "Pending" : Model.Owner)
                    </div>
                </div>

                <!-- Repository Identifier -->
                <div class="col-sm-6 col-lg-4">
                    <div class="text-muted small fw-medium mb-1">
                        <i class="bi bi-folder2-open me-1"></i> Repository Slug
                    </div>
                    <div class="fw-medium text-dark">
                        @(string.IsNullOrEmpty(Model.RepoName) ? "Pending" : Model.RepoName)
                    </div>
                </div>

                <!-- Size -->
                <div class="col-sm-6 col-lg-4">
                    <div class="text-muted small fw-medium mb-1">
                        <i class="bi bi-file-earmark-zip me-1"></i> Repository Size
                    </div>
                    <div class="fw-medium text-dark">
                        @Model.SizeKb.ToString("N0") KB
                    </div>
                </div>

                <!-- Added Date -->
                <div class="col-sm-6 col-lg-4">
                    <div class="text-muted small fw-medium mb-1">
                        <i class="bi bi-calendar-check me-1"></i> Registered At
                    </div>
                    <div class="text-dark">
                        @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                    </div>
                </div>

                <!-- Last Scanned -->
                <div class="col-sm-6 col-lg-4">
                    <div class="text-muted small fw-medium mb-1">
                        <i class="bi bi-shield-check me-1"></i> Last Scanned
                    </div>
                    <div>
                        @if (Model.LastScannedAt.HasValue)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                <i class="bi bi-check-circle me-1"></i> @Model.LastScannedAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                <i class="bi bi-clock-history me-1"></i> Never Scanned
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions & Analysis Operations (Located in the down side after the Repo Box) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3 px-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-cpu text-success"></i>
                        Operations & Pipeline Analysis
                    </h5>
                    <small class="text-muted">
                        @(User.IsInRole("Admin") ? "Inspect pipeline configurations and vulnerability audit reports." : "Trigger security scans, analyze pipelines, and inspect audit reports.")
                    </small>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center gap-3">
                @if (!User.IsInRole("Admin"))
                {
                    <!-- Scan Repository Button (Primary action for regular users) -->
                    <form asp-controller="Scan"
                          asp-action="Start"
                          method="post"
                          class="d-inline"
                          id="scanRepoForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="repositoryId" value="@Model.Id" />
                        <button type="submit" id="scanRepoBtn" class="btn btn-success fw-semibold px-4 py-2 shadow-sm d-flex align-items-center gap-2">
                            <i class="bi bi-shield-check fs-5"></i>
                            <span id="scanRepoBtnText">Scan Repository</span>
                        </button>
                    </form>

                    <!-- Refresh Metadata Button -->
                    <form asp-controller="Repository"
                          asp-action="RefreshMetadata"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary fw-medium px-3 py-2 d-flex align-items-center gap-2">
                            <i class="bi bi-arrow-clockwise fs-5"></i>
                            <span>Refresh Metadata</span>
                        </button>
                    </form>
                }

                <!-- View Pipeline Button (Only available if repository has been scanned) -->
                @if (hasBeenScanned)
                {
                    <a asp-controller="Pipeline"
                       asp-action="Index"
                       asp-route-repositoryId="@Model.Id"
                       class="btn btn-primary fw-medium px-3 py-2 shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-diagram-3 fs-5"></i>
                        <span>View Pipeline</span>
                    </a>

                    <!-- View Report Button -->
                    <a asp-controller="Report"
                       asp-action="Index"
                       asp-route-repositoryId="@Model.Id"
                       class="btn btn-dark fw-medium px-3 py-2 shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-bar-graph fs-5"></i>
                        <span>View Report</span>
                    </a>
                }
            </div>

            @if (!hasBeenScanned)
            {
                <div class="alert alert-info d-flex align-items-center gap-3 mt-4 mb-0 border-0 bg-info-subtle text-info-emphasis rounded-3">
                    <i class="bi bi-info-circle-fill fs-4 flex-shrink-0"></i>
                    <div>
                        @if (User.IsInRole("Admin"))
                        {
                            <span>This repository has not been scanned by the owner yet. Pipeline and vulnerability analysis reports will be generated once scanned.</span>
                        }
                        else
                        {
                            <span><strong>Scan required:</strong> Click <strong>Scan Repository</strong> above to analyze CI/CD configuration files, visualize pipeline execution flow, and detect security vulnerabilities.</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade"
     id="deleteRepositoryModal"
     tabindex="-1"
     aria-labelledby="deleteRepositoryModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <!-- Modal Header -->
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fw-bold text-danger d-flex align-items-center gap-2"
                    id="deleteRepositoryModalLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Delete Repository
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-4">
                <p class="mb-2 fs-6">
                    Are you sure you want to permanently delete repository
                    <strong>@Model.Name</strong>?
                </p>
                <div class="alert alert-danger-subtle text-danger border border-danger-subtle p-2 mb-0 small">
                    <i class="bi bi-exclamation-circle me-1"></i> This action is permanent and will delete associated scan histories and pipeline data.
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer border-top bg-light">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form asp-controller="Repository"
                      asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn btn-danger fw-semibold px-3">
                        <i class="bi bi-trash3 me-1"></i> Delete Repository
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

<!-- Private Repository Detected Modal -->
<div class="modal fade"
     id="privateRepoModal"
     tabindex="-1"
     aria-labelledby="privateRepoModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="privateRepoModalLabel">
                    <i class="bi bi-lock-fill text-warning fs-5"></i>
                    Private Repository Detected
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div class="mx-auto mb-3 d-inline-flex align-items-center justify-content-center rounded-circle bg-warning-subtle text-warning" style="width: 70px; height: 70px;">
                    <i class="bi bi-shield-lock" style="font-size: 2.2rem;"></i>
                </div>
                <h5 class="fw-bold mb-2 text-dark">This is a Private Repository</h5>
                <p class="text-muted mb-0" id="privateRepoModalMessage">
                    This repository is private or requires authentication credentials. DeployGuard currently supports scanning public repositories only.
                </p>
            </div>
            <div class="modal-footer border-top bg-light justify-content-center">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    Understood
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var scanForm = document.getElementById("scanRepoForm");
        var scanBtn = document.getElementById("scanRepoBtn");
        var scanBtnText = document.getElementById("scanRepoBtnText");
        var modalEl = document.getElementById("privateRepoModal");
        var modalMessageEl = document.getElementById("privateRepoModalMessage");

        @if (TempData["PrivateRepoError"] != null)
        {
            <text>
            if (modalEl) {
                var message = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["PrivateRepoError"]?.ToString() ?? ""));
                if (message && modalMessageEl) {
                    modalMessageEl.innerText = message;
                }
                var bsModal = new bootstrap.Modal(modalEl);
                bsModal.show();
            }
            </text>
        }

        if (scanForm && scanBtn) {
            scanForm.addEventListener("submit", function (e) {
                e.preventDefault();

                var originalHtml = scanBtn.innerHTML;
                scanBtn.disabled = true;
                scanBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span><span>Scanning Repository...</span>';

                var formData = new FormData(scanForm);

                fetch(scanForm.action, {
                    method: "POST",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest",
                        "Accept": "application/json"
                    },
                    body: formData
                })
                .then(function (res) {
                    return res.json().catch(function () {
                        // Fallback reload if non-json response
                        window.location.reload();
                    });
                })
                .then(function (data) {
                    if (!data) return;

                    if (data.success && data.redirectUrl) {
                        window.location.href = data.redirectUrl;
                    } else if (data.isPrivate) {
                        scanBtn.disabled = false;
                        scanBtn.innerHTML = originalHtml;
                        if (data.message && modalMessageEl) {
                            modalMessageEl.innerText = data.message;
                        }
                        if (modalEl) {
                            var bsModal = new bootstrap.Modal(modalEl);
                            bsModal.show();
                        }
                    } else {
                        scanBtn.disabled = false;
                        scanBtn.innerHTML = originalHtml;
                        alert(data.message || "An error occurred while scanning the repository.");
                    }
                })
                .catch(function () {
                    scanBtn.disabled = false;
                    scanBtn.innerHTML = originalHtml;
                    scanForm.submit();
                });
            });
        }
    });
</script>
}
