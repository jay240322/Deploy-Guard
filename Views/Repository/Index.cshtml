@model IEnumerable<Deployguard.Models.Repository>

@{
    ViewData["Title"] = "Repositories";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1>Repositories</h1>
        <p class="text-muted mb-0">
            Manage your Git repositories.
        </p>
    </div>

    <a asp-controller="Repository"
       asp-action="Create"
       class="btn btn-primary">
        + Add Repository
    </a>

</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">

            <h4>No repositories yet</h4>

            <p class="text-muted">
                Add your first Git repository to start using DeployGuard.
            </p>

            <a asp-controller="Repository"
               asp-action="Create"
               class="btn btn-primary">
                Add Repository
            </a>

        </div>
    </div>
}
else
{
    <div class="row">

        @foreach (var repository in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">
                                @repository.Name
                            </h5>
                            <span class="fs-5" title="@repository.Provider">
                                <partial name="_ProviderIcon" model="repository.Provider" />
                            </span>
                        </div>

                        <p class="text-muted small">
                            @repository.RepoUrl
                        </p>

                        <hr />

                        <p class="mb-1 d-flex align-items-center gap-2">
                            <strong>Provider:</strong>
                            <span class="fs-5">
                                <partial name="_ProviderIcon" model="repository.Provider" />
                            </span>
                        </p>

                        <p class="mb-1">
                            <strong>Owner:</strong>
                            @(string.IsNullOrEmpty(repository.Owner)
                                ? "Pending"
                                : repository.Owner)
                        </p>

                        <p class="mb-1">
                            <strong>Branch:</strong>
                            @(string.IsNullOrEmpty(repository.DefaultBranch)
                                ? "Pending"
                                : repository.DefaultBranch)
                        </p>

                        <p class="mb-3">
                            <strong>Language:</strong>
                            @(string.IsNullOrEmpty(repository.Language)
                                ? "Pending"
                                : repository.Language)
                        </p>

                        <div class="d-flex align-items-center gap-2">
                            <a asp-controller="Repository"
                               asp-action="Details"
                               asp-route-id="@repository.Id"
                               class="btn btn-outline-primary btn-sm">
                                View Details
                            </a>

                            <form asp-controller="Scan"
                                  asp-action="Start"
                                  method="post"
                                  class="d-inline index-scan-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="repositoryId" value="@repository.Id" />
                                <button type="submit" class="btn btn-success btn-sm d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-shield-check"></i>
                                    <span>Scan</span>
                                </button>
                            </form>
                        </div>

                    </div>

                    <div class="card-footer text-muted small">
                        Added @repository.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                    </div>

                </div>

            </div>
        }

    </div>
}

<!-- Private Repository Detected Modal -->
<div class="modal fade"
     id="privateRepoModal"
     tabindex="-1"
     aria-labelledby="privateRepoModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="privateRepoModalLabel">
                    <i class="bi bi-lock-fill text-warning fs-5"></i>
                    Private Repository Detected
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div class="mx-auto mb-3 d-inline-flex align-items-center justify-content-center rounded-circle bg-warning-subtle text-warning" style="width: 70px; height: 70px;">
                    <i class="bi bi-shield-lock" style="font-size: 2.2rem;"></i>
                </div>
                <h5 class="fw-bold mb-2 text-dark">This is a Private Repository</h5>
                <p class="text-muted mb-0" id="privateRepoModalMessage">
                    This repository is private or requires authentication credentials. DeployGuard currently supports scanning public repositories only.
                </p>
            </div>
            <div class="modal-footer border-top bg-light justify-content-center">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    Understood
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var modalEl = document.getElementById("privateRepoModal");
        var modalMessageEl = document.getElementById("privateRepoModalMessage");

        @if (TempData["PrivateRepoError"] != null)
        {
            <text>
            if (modalEl) {
                var message = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["PrivateRepoError"]?.ToString() ?? ""));
                if (message && modalMessageEl) {
                    modalMessageEl.innerText = message;
                }
                var bsModal = new bootstrap.Modal(modalEl);
                bsModal.show();
            }
            </text>
        }

        document.querySelectorAll(".index-scan-form").forEach(function (form) {
            form.addEventListener("submit", function (e) {
                e.preventDefault();

                var btn = form.querySelector("button[type='submit']");
                var originalHtml = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';

                var formData = new FormData(form);

                fetch(form.action, {
                    method: "POST",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest",
                        "Accept": "application/json"
                    },
                    body: formData
                })
                .then(function (res) {
                    return res.json().catch(function () {
                        window.location.reload();
                    });
                })
                .then(function (data) {
                    if (!data) return;

                    if (data.success && data.redirectUrl) {
                        window.location.href = data.redirectUrl;
                    } else if (data.isPrivate) {
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                        if (data.message && modalMessageEl) {
                            modalMessageEl.innerText = data.message;
                        }
                        if (modalEl) {
                            var bsModal = new bootstrap.Modal(modalEl);
                            bsModal.show();
                        }
                    } else {
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                        alert(data.message || "An error occurred while scanning the repository.");
                    }
                })
                .catch(function () {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                    form.submit();
                });
            });
        });
    });
</script>
}