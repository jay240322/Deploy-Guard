@model Deployguard.Models.Repository

@{
ViewData["Title"] = "Edit Repository";
}

<div class="row justify-content-center">
    <div class="col-md-7">
    <div class="card shadow-sm">

        <div class="card-body p-4">

            <h2 class="mb-2">
                Edit Repository
            </h2>

            <p class="text-muted mb-4">
                Update your repository information.
            </p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Repository"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">

                    <label class="form-label">
                        Repository Name
                    </label>

                    <input type="text"
                           name="name"
                           value="@Model.Name"
                           class="form-control"
                           required />

                </div>

                <div class="mb-4">

                    <label class="form-label">
                        Repository URL
                    </label>

                    <input type="url"
                           name="repoUrl"
                           value="@Model.RepoUrl"
                           class="form-control"
                           required />

                    <div class="form-text">
                        Supported providers:
                        GitHub, GitLab, Bitbucket and Azure DevOps.
                    </div>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-controller="Repository"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
</div>
