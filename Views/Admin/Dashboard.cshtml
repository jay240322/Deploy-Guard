@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-shield-shaded me-2 text-danger"></i>
                DeployGuard Admin Portal
            </h1>
            <p class="text-muted mb-0">
                Welcome back, <strong>@User.Identity?.Name</strong>
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-primary d-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-people"></i>
                <span>Users</span>
            </a>
            <a asp-controller="Admin" asp-action="Report" class="btn btn-danger text-white d-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-file-earmark-bar-graph"></i>
                <span>Reports & PDF</span>
            </a>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-md-3">
            <a asp-controller="Admin" asp-action="Users" class="text-decoration-none text-dark">
                <div class="card shadow-sm p-4 h-100 border-0 rounded-3 hover-card">
                    <div class="fs-2 text-primary mb-2">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h5 class="fw-bold">User Management</h5>
                    <p class="text-muted small mb-0">Manage registered users, inspect activity, and remove accounts.</p>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-controller="Admin" asp-action="Report" class="text-decoration-none text-dark">
                <div class="card shadow-sm p-4 h-100 border-0 rounded-3 hover-card">
                    <div class="fs-2 text-info mb-2">
                        <i class="bi bi-activity"></i>
                    </div>
                    <h5 class="fw-bold">Scan Usage</h5>
                    <p class="text-muted small mb-0">Track how many times DeployGuard was used for scans & runtime.</p>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-controller="Admin" asp-action="Report" class="text-decoration-none text-dark">
                <div class="card shadow-sm p-4 h-100 border-0 rounded-3 hover-card">
                    <div class="fs-2 text-danger mb-2">
                        <i class="bi bi-shield-exclamation"></i>
                    </div>
                    <h5 class="fw-bold">Security Reports</h5>
                    <p class="text-muted small mb-0">Live scan usage statistics, most risky repositories, and PDF export.</p>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-controller="Admin" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card shadow-sm p-4 h-100 border-0 rounded-3 hover-card">
                    <div class="fs-2 text-success mb-2">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                    <h5 class="fw-bold">Full Analytics</h5>
                    <p class="text-muted small mb-0">Review comprehensive metrics, recent scans, and audit activity.</p>
                </div>
            </a>
        </div>
    </div>
</div>