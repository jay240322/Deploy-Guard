@model Deployguard.Models.AdminUsersViewModel

@{
    ViewData["Title"] = "User Management";
}

<div class="py-4">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger text-white px-2 py-1">
                    <i class="bi bi-shield-lock-fill me-1"></i> Admin Portal
                </span>
                <h2 class="fw-bold mb-0">User Management</h2>
            </div>
            <p class="text-muted mb-0">
                View registered platform users, monitor their repositories and security activity, and manage permissions.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Admin"
               asp-action="Index"
               class="btn btn-outline-secondary d-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-arrow-left"></i>
                <span>Admin Dashboard</span>
            </a>

            <a asp-controller="Admin"
               asp-action="Report"
               class="btn btn-primary d-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-file-earmark-bar-graph"></i>
                <span>Security Reports</span>
            </a>
        </div>
    </div>

    <!-- Alert notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["Success"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@TempData["Error"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- User KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-medium">Total Registered Users</div>
                        <div class="fs-4 fw-bold text-dark">@Model.Users.Count</div>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-3">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-medium">Total Scans Triggered</div>
                        <div class="fs-4 fw-bold text-success">
                            @Model.Users.Sum(u => u.ScansCount)
                        </div>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-3">
                        <i class="bi bi-shield-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-medium">Active Accounts</div>
                        <div class="fs-4 fw-bold text-success">
                            @Model.Users.Count(u => u.IsActive)
                        </div>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-3">
                        <i class="bi bi-person-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-medium">Total Repos Managed</div>
                        <div class="fs-4 fw-bold text-info">
                            @Model.Users.Sum(u => u.RepositoriesCount)
                        </div>
                    </div>
                    <div class="p-3 bg-info-subtle text-info rounded-3">
                        <i class="bi bi-folder2-open fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Users Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <div>
                    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-person-lines-fill text-primary"></i>
                        Registered Accounts
                    </h5>
                    <small class="text-muted">Manage system users, view activity, or remove unauthorized access.</small>
                </div>
                <div class="badge bg-light text-dark border px-3 py-2">
                    <i class="bi bi-person-check me-1"></i> @Model.Users.Count accounts total
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            @if (!Model.Users.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-people fs-1 text-muted"></i>
                    <h5 class="fw-bold mt-3">No Users Found</h5>
                    <p class="text-muted mb-0">There are currently no registered users in the database.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">User</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Repositories</th>
                                <th>Scans Run</th>
                                <th>Registered At</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                var isCurrentUser = user.Id == Model.CurrentUserId;
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                                 style="width: 36px; height: 36px;">
                                                @(string.IsNullOrEmpty(user.FullName) ? user.UserName.Substring(0, 1).ToUpper() : user.FullName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">
                                                    @(string.IsNullOrEmpty(user.FullName) ? user.UserName : user.FullName)
                                                    @if (isCurrentUser)
                                                    {
                                                        <span class="badge bg-primary ms-1">You</span>
                                                    }
                                                </div>
                                                <div class="small text-muted">@@@user.UserName</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="mailto:@user.Email" class="text-decoration-none text-muted">
                                            <i class="bi bi-envelope me-1"></i>@user.Email
                                        </a>
                                    </td>
                                    <td>
                                        @if (user.Role == "Admin")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-shield-fill-check me-1"></i> Admin
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                                <i class="bi bi-person me-1"></i> User
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-dot"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                                <i class="bi bi-dot"></i> Inactive
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-folder me-1 text-primary"></i> @user.RepositoriesCount
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-shield-check me-1 text-success"></i> @user.ScansCount
                                        </span>
                                    </td>
                                    <td>
                                        <span class="small text-muted">
                                            @user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (isCurrentUser)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" disabled title="Cannot delete currently logged-in account">
                                                <i class="bi bi-lock me-1"></i> Protected
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteUserModal-@user.Id">
                                                <i class="bi bi-trash3"></i>
                                                <span>Delete</span>
                                            </button>

                                            <!-- Delete User Modal -->
                                            <div class="modal fade"
                                                 id="deleteUserModal-@user.Id"
                                                 tabindex="-1"
                                                 aria-labelledby="deleteUserModalLabel-@user.Id"
                                                 aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered text-start">
                                                    <div class="modal-content border-0 shadow">
                                                        <div class="modal-header border-bottom bg-light">
                                                            <h5 class="modal-title fw-bold text-danger d-flex align-items-center gap-2"
                                                                id="deleteUserModalLabel-@user.Id">
                                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                                                Delete User Account
                                                            </h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body p-4">
                                                            <p class="mb-2">
                                                                Are you sure you want to permanently delete user
                                                                <strong>@user.UserName</strong> (<code>@user.Email</code>)?
                                                            </p>
                                                            <div class="alert alert-danger-subtle text-danger border border-danger-subtle p-2 mb-0 small">
                                                                <i class="bi bi-exclamation-circle me-1"></i> This will delete the user and cascade-remove all @user.RepositoriesCount repositories, @user.ScansCount scan logs, and pipeline artifacts owned by this account.
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-top bg-light">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <form asp-controller="Admin"
                                                                  asp-action="DeleteUser"
                                                                  asp-route-id="@user.Id"
                                                                  method="post"
                                                                  class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-danger fw-semibold px-3">
                                                                    <i class="bi bi-trash3 me-1"></i> Delete User
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>
