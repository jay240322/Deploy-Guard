@{
    ViewData["Title"] = "DeployGuard - Enterprise DevSecOps & Secret Scanner";
}

<!-- HERO SECTION -->
<section class="landing-hero py-5 py-lg-6 position-relative overflow-hidden">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            
            <!-- Left Column: Copy & CTAs -->
            <div class="col-lg-6">
                
                <!-- Badge -->
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary-subtle text-primary border border-primary-subtle mb-3 fs-6 fw-medium shadow-sm">
                    <i class="bi bi-shield-check"></i>
                    <span>Next-Gen Security & DevSecOps Intelligence</span>
                </div>

                <!-- Main Heading -->
                <h1 class="display-4 fw-extrabold text-main mb-3 lh-sm tracking-tight">
                    Detect Secrets & Secure Pipelines <span class="text-gradient">Before You Deploy</span>
                </h1>

                <!-- Subtitle -->
                <p class="lead text-muted mb-4 fs-5" style="line-height: 1.6;">
                    DeployGuard continuously scans repositories for exposed API tokens, database credentials, and CI/CD pipeline vulnerabilities in seconds.
                </p>

                <!-- Actions -->
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn btn-primary btn-lg px-4 py-3 rounded-3 shadow d-inline-flex align-items-center gap-2 fw-semibold hero-cta-btn">
                        <span>Get Started Free</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-secondary btn-lg px-4 py-3 rounded-3 fw-semibold d-inline-flex align-items-center gap-2">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Sign In</span>
                    </a>
                </div>

                <!-- Trust Points -->
                <div class="d-flex flex-wrap gap-4 text-muted small pt-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span>Zero Data Retention</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span>Automated Sandboxed Scans</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span>PDF Audit Reports</span>
                    </div>
                </div>

            </div>

            <!-- Right Column: Interactive Live Security Scanner Simulation -->
            <div class="col-lg-6">
                <div class="landing-preview-card border-0 shadow-lg rounded-4 overflow-hidden position-relative">
                    
                    <!-- Terminal / Window Header -->
                    <div class="preview-header px-4 py-3 bg-dark text-light d-flex align-items-center justify-content-between border-bottom border-secondary border-opacity-25">
                        <div class="d-flex align-items-center gap-2">
                            <span class="dot bg-danger rounded-circle d-inline-block" style="width: 10px; height: 10px;"></span>
                            <span class="dot bg-warning rounded-circle d-inline-block" style="width: 10px; height: 10px;"></span>
                            <span class="dot bg-success rounded-circle d-inline-block" style="width: 10px; height: 10px;"></span>
                            <span class="small text-muted ms-2 font-monospace">deployguard-engine v2.4</span>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                            <i class="bi bi-check-circle-fill me-1"></i> Scan Completed
                        </span>
                    </div>

                    <!-- Terminal Content -->
                    <div class="preview-body p-4 bg-darker font-monospace text-light">
                        <div class="mb-3 text-muted small">
                            <span class="text-primary fw-bold">$</span> deployguard scan https://github.com/company/core-service --deep
                        </div>

                        <!-- Scan Metrics -->
                        <div class="row g-2 mb-3 small">
                            <div class="col-6 col-md-3">
                                <div class="p-2 rounded bg-dark border border-secondary border-opacity-25 text-center">
                                    <div class="text-muted" style="font-size: 0.75rem;">Files</div>
                                    <div class="fw-bold text-light">142</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2 rounded bg-dark border border-secondary border-opacity-25 text-center">
                                    <div class="text-muted" style="font-size: 0.75rem;">Duration</div>
                                    <div class="fw-bold text-light">1.24s</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2 rounded bg-dark border border-secondary border-opacity-25 text-center">
                                    <div class="text-muted" style="font-size: 0.75rem;">Status</div>
                                    <div class="fw-bold text-success">Cleaned</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2 rounded bg-dark border border-secondary border-opacity-25 text-center">
                                    <div class="text-muted" style="font-size: 0.75rem;">Risk</div>
                                    <div class="fw-bold text-danger">Critical</div>
                                </div>
                            </div>
                        </div>

                        <!-- Live Findings Preview -->
                        <div class="findings-stream small">
                            <div class="p-2 rounded mb-2 bg-danger bg-opacity-10 border border-danger border-opacity-25 d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="badge bg-danger me-1">CRITICAL</span>
                                    <span class="text-light">AWS Access Key ID in <code class="text-danger-subtle">src/config.json:14</code></span>
                                </div>
                                <span class="text-muted" style="font-size: 0.75rem;">AKIA...4X9Q</span>
                            </div>

                            <div class="p-2 rounded mb-2 bg-warning bg-opacity-10 border border-warning border-opacity-25 d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="badge bg-warning text-dark me-1">HIGH</span>
                                    <span class="text-light">Database Connection String in <code class="text-warning-subtle">.env.staging:4</code></span>
                                </div>
                                <span class="text-muted" style="font-size: 0.75rem;">postgres://...</span>
                            </div>

                            <div class="p-2 rounded bg-info bg-opacity-10 border border-info border-opacity-25 d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="badge bg-info text-dark me-1">INFO</span>
                                    <span class="text-light">CI/CD Pipeline: GitHub Actions detected in <code class="text-info-subtle">.github/workflows/deploy.yml</code></span>
                                </div>
                                <i class="bi bi-arrow-repeat text-info"></i>
                            </div>
                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>
</section>

<!-- GIT PROVIDERS SECTION -->
<section class="py-4 border-top border-bottom bg-subtle" id="integrations">
    <div class="container text-center">
        <p class="text-muted small fw-semibold text-uppercase tracking-wider mb-3">
            Seamlessly Integrated with Leading Git & DevOps Providers
        </p>
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-4 gap-md-5">
            <div class="d-flex align-items-center gap-2 text-main fw-semibold fs-5 opacity-75 hover-opacity-100 transition-all">
                <i class="bi bi-github fs-3"></i>
                <span>GitHub</span>
            </div>
            <div class="d-flex align-items-center gap-2 text-main fw-semibold fs-5 opacity-75 hover-opacity-100 transition-all">
                <i class="bi bi-gitlab fs-3 text-warning"></i>
                <span>GitLab</span>
            </div>
            <div class="d-flex align-items-center gap-2 text-main fw-semibold fs-5 opacity-75 hover-opacity-100 transition-all">
                <i class="bi bi-git fs-3 text-primary"></i>
                <span>Bitbucket</span>
            </div>
            <div class="d-flex align-items-center gap-2 text-main fw-semibold fs-5 opacity-75 hover-opacity-100 transition-all">
                <i class="bi bi-microsoft fs-3 text-info"></i>
                <span>Azure DevOps</span>
            </div>
        </div>
    </div>
</section>

<!-- CORE FEATURES GRID -->
<section class="py-5 py-lg-6" id="features">
    <div class="container">
        
        <!-- Section Header -->
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill mb-2 fw-medium">
                Comprehensive Protection
            </span>
            <h2 class="display-6 fw-bold text-main mb-3">
                Everything You Need to Prevent Secret Leaks
            </h2>
            <p class="text-muted fs-5">
                Built specifically for modern development teams to catch credentials, tokens, and insecure configs before production releases.
            </p>
        </div>

        <!-- Features Row -->
        <div class="row g-4">
            
            <!-- Feature 1 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card transition-all">
                    <div class="feature-icon-wrapper mb-3 bg-primary-subtle text-primary rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-key-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">Deep Secret Scanner</h5>
                    <p class="text-muted mb-0">
                        Scan codebases for AWS keys, Stripe tokens, private SSH keys, OpenAI API keys, database strings, and passwords using optimized regex rules.
                    </p>
                </div>
            </div>

            <!-- Feature 2 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card transition-all">
                    <div class="feature-icon-wrapper mb-3 bg-info-subtle text-info rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-diagram-3-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">CI/CD Pipeline Analysis</h5>
                    <p class="text-muted mb-0">
                        Automatically inspect GitHub Actions, GitLab CI, and Azure Pipelines files for unsafe steps, exposed environment variables, and branch rules.
                    </p>
                </div>
            </div>

            <!-- Feature 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card transition-all">
                    <div class="feature-icon-wrapper mb-3 bg-success-subtle text-success rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-lightning-charge-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">Sub-Second Sandboxing</h5>
                    <p class="text-muted mb-0">
                        Clones shallow repository snapshots inside isolated execution sandboxes and securely wipes all code immediately after inspection.
                    </p>
                </div>
            </div>

            <!-- Feature 4 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card transition-all">
                    <div class="feature-icon-wrapper mb-3 bg-danger-subtle text-danger rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-file-earmark-pdf-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">Executive PDF Reports</h5>
                    <p class="text-muted mb-0">
                        Generate comprehensive PDF security reports with severity risk ratings, finding locations, and compliance audits for management.
                    </p>
                </div>
            </div>

            <!-- Feature 5 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card transition-all">
                    <div class="feature-icon-wrapper mb-3 bg-warning-subtle text-warning rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-shield-lock-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">Admin Governance Portal</h5>
                    <p class="text-muted mb-0">
                        Centralized platform administrative dashboard to monitor cross-organization risk scores, top secret categories, and user activity.
                    </p>
                </div>
            </div>

            <!-- Feature 6 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card transition-all">
                    <div class="feature-icon-wrapper mb-3 bg-purple-subtle text-purple rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-google fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">Single Sign-On & Auth</h5>
                    <p class="text-muted mb-0">
                        One-click Google Firebase Sign-In, secure bcrypt password hashing, and encrypted cookie sessions for effortless team onboarding.
                    </p>
                </div>
            </div>

        </div>

    </div>
</section>

<!-- HOW IT WORKS SECTION -->
<section class="py-5 py-lg-6 bg-subtle" id="how-it-works">
    <div class="container">
        
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill mb-2 fw-medium">
                Simple 3-Step Workflow
            </span>
            <h2 class="display-6 fw-bold text-main mb-3">
                How DeployGuard Works
            </h2>
            <p class="text-muted fs-5">
                Protecting your codebase takes less than 30 seconds with no complex agent installations required.
            </p>
        </div>

        <div class="row g-4 justify-content-center">
            
            <!-- Step 1 -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-card">
                    <div class="step-badge mx-auto mb-3 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 44px; height: 44px;">
                        1
                    </div>
                    <h5 class="fw-bold text-main mb-2">Connect Repository</h5>
                    <p class="text-muted small mb-0">
                        Add any public or private repository URL from GitHub, GitLab, Bitbucket, or Azure DevOps.
                    </p>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-card">
                    <div class="step-badge mx-auto mb-3 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 44px; height: 44px;">
                        2
                    </div>
                    <h5 class="fw-bold text-main mb-2">Run Automated Scan</h5>
                    <p class="text-muted small mb-0">
                        DeployGuard inspects commit files and CI/CD pipelines across dozens of active secret detection rules.
                    </p>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-card">
                    <div class="step-badge mx-auto mb-3 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 44px; height: 44px;">
                        3
                    </div>
                    <h5 class="fw-bold text-main mb-2">Remediate & Export</h5>
                    <p class="text-muted small mb-0">
                        View exact line numbers, severity breakdown, and download audit-ready executive PDF reports.
                    </p>
                </div>
            </div>

        </div>

    </div>
</section>

<!-- CALL TO ACTION BANNER -->
<section class="py-5 py-lg-6">
    <div class="container">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden landing-cta-card p-4 p-md-5 text-center text-white position-relative">
            <div class="position-relative z-1 max-w-700 mx-auto">
                <h2 class="display-6 fw-bold mb-3">
                    Start Securing Your Repositories Today
                </h2>
                <p class="lead opacity-90 mb-4 fs-5">
                    Prevent high-impact security breaches and safeguard your cloud infrastructure with DeployGuard.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn btn-light btn-lg px-4 py-3 fw-bold text-primary rounded-3 shadow">
                        <i class="bi bi-sparkles me-1"></i> Create Free Account
                    </a>
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-light btn-lg px-4 py-3 fw-semibold rounded-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Landing Hero Styles */
    .landing-hero {
        background: radial-gradient(circle at 80% 20%, rgba(37, 99, 235, 0.08) 0%, transparent 60%);
    }

    [data-bs-theme="dark"] .landing-hero {
        background: radial-gradient(circle at 80% 20%, rgba(37, 99, 235, 0.15) 0%, transparent 60%);
    }

    .text-gradient {
        background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .fw-extrabold {
        font-weight: 800;
    }

    .max-w-700 {
        max-width: 700px;
    }

    .bg-darker {
        background-color: #0b1120 !important;
    }

    .bg-subtle {
        background-color: rgba(241, 245, 249, 0.6);
    }

    [data-bs-theme="dark"] .bg-subtle {
        background-color: rgba(15, 23, 42, 0.5) !important;
    }

    .bg-card {
        background-color: var(--bs-body-bg);
    }

    .bg-purple-subtle {
        background-color: rgba(147, 51, 234, 0.1) !important;
    }

    .text-purple {
        color: #9333ea !important;
    }

    .feature-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08) !important;
    }

    .landing-cta-card {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 50%, #6366f1 100%);
    }

    .hero-cta-btn {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        border: none;
        transition: all 0.25s ease;
    }

    .hero-cta-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(37, 99, 235, 0.4) !important;
    }
</style>
