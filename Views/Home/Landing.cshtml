@{
    ViewData["Title"] = "DeployGuard - Repository Security Scanner";
    ViewData["HideFooter"] = true;
}

<!-- HERO SECTION -->
<section class="landing-hero py-5 py-lg-6 position-relative">
    <div class="container py-2">
        <div class="row align-items-center g-5">
            
            <!-- Left Column: Copy & Actions -->
            <div class="col-lg-6">
                
                <!-- Badge -->
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-light text-dark border mb-3 fs-6 shadow-xs">
                    <img src="~/images/logo.png" alt="DeployGuard Logo" width="18" height="18" class="rounded-circle" />
                    <span class="small fw-medium">Repository Security & Secret Scanner</span>
                </div>

                <!-- Main Heading -->
                <h1 class="display-5 fw-bold text-main mb-3 lh-sm">
                    Scan Git Repositories for Secrets & Credentials
                </h1>

                <!-- Subtitle -->
                <p class="text-muted mb-4 fs-5" style="line-height: 1.6;">
                    DeployGuard is a web-based code analysis tool that scans repositories to detect hardcoded API keys, database credentials, exposed passwords, and CI/CD pipeline configurations.
                </p>

                <!-- Actions -->
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn btn-primary btn-lg px-4 py-2.5 rounded-3 shadow-sm d-inline-flex align-items-center gap-2 fw-semibold">
                        <span>Get Started</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-secondary btn-lg px-4 py-2.5 rounded-3 fw-semibold d-inline-flex align-items-center gap-2">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Sign In</span>
                    </a>
                </div>

                <!-- Key Highlights -->
                <div class="d-flex flex-wrap gap-4 text-muted small pt-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check2-circle text-primary"></i>
                        <span>Shallow Git Cloning</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check2-circle text-primary"></i>
                        <span>Automated Secret Rules</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check2-circle text-primary"></i>
                        <span>PDF Report Generation</span>
                    </div>
                </div>

            </div>

            <!-- Right Column: Realistic Sample Scan Summary Card -->
            <div class="col-lg-6">
                <div class="card border shadow-sm rounded-4 overflow-hidden bg-white">
                    
                    <!-- Card Header -->
                    <div class="card-header bg-light border-bottom px-4 py-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-folder2-open text-primary fs-5"></i>
                            <span class="fw-semibold text-dark small font-monospace">example-service / api-backend</span>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small fw-medium">
                            <i class="bi bi-check-circle me-1"></i> Scan Completed
                        </span>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body p-4">
                        
                        <!-- Scan Metrics -->
                        <div class="row g-2 mb-3 text-center">
                            <div class="col-4">
                                <div class="p-2 rounded bg-light border">
                                    <div class="text-muted small">Files Scanned</div>
                                    <div class="fw-bold text-dark fs-6">38</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded bg-light border">
                                    <div class="text-muted small">Scan Time</div>
                                    <div class="fw-bold text-dark fs-6">0.82s</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded bg-light border">
                                    <div class="text-muted small">Findings</div>
                                    <div class="fw-bold text-danger fs-6">2</div>
                                </div>
                            </div>
                        </div>

                        <!-- Sample Findings -->
                        <div class="d-flex flex-column gap-2 small">
                            <div class="p-2.5 rounded border d-flex align-items-center justify-content-between bg-light">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-danger">Critical</span>
                                    <span class="text-dark fw-medium">AWS Access Key</span>
                                    <code class="text-muted small">config.json:14</code>
                                </div>
                                <span class="font-monospace text-muted small">AKIA************</span>
                            </div>

                            <div class="p-2.5 rounded border d-flex align-items-center justify-content-between bg-light">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-warning text-dark">High</span>
                                    <span class="text-dark fw-medium">Database Password</span>
                                    <code class="text-muted small">appsettings.json:8</code>
                                </div>
                                <span class="font-monospace text-muted small">postgres://...</span>
                            </div>

                            <div class="p-2.5 rounded border d-flex align-items-center justify-content-between bg-light">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-info text-dark">Info</span>
                                    <span class="text-dark fw-medium">GitHub Actions Pipeline</span>
                                    <code class="text-muted small">.github/workflows/deploy.yml</code>
                                </div>
                                <i class="bi bi-check-lg text-success"></i>
                            </div>
                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>
</section>

<!-- SUPPORTED GIT PROVIDERS -->
<section class="py-5 border-top border-bottom bg-subtle" id="integrations">
    <div class="container">
        <div class="text-center mx-auto mb-4" style="max-width: 650px;">
            <h3 class="fw-bold text-main mb-2">Supported Git Providers</h3>
            <p class="text-muted small mb-0">Scan public repositories from any of the following platforms using their standard repository URLs.</p>
        </div>

        <div class="row g-3 justify-content-center pt-2">
            <div class="col-6 col-md-3">
                <div class="p-3 bg-white rounded-3 border text-center shadow-xs h-100 d-flex flex-column align-items-center justify-content-center gap-1">
                    <i class="bi bi-github fs-2 text-dark"></i>
                    <div class="fw-semibold text-main">GitHub</div>
                    <small class="text-muted">Public Repositories</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 bg-white rounded-3 border text-center shadow-xs h-100 d-flex flex-column align-items-center justify-content-center gap-1">
                    <i class="bi bi-gitlab fs-2 text-warning"></i>
                    <div class="fw-semibold text-main">GitLab</div>
                    <small class="text-muted">Public Projects & CI</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 bg-white rounded-3 border text-center shadow-xs h-100 d-flex flex-column align-items-center justify-content-center gap-1">
                    <i class="bi bi-git fs-2 text-primary"></i>
                    <div class="fw-semibold text-main">Bitbucket</div>
                    <small class="text-muted">Public Repositories</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 bg-white rounded-3 border text-center shadow-xs h-100 d-flex flex-column align-items-center justify-content-center gap-1">
                    <i class="bi bi-microsoft fs-2 text-info"></i>
                    <div class="fw-semibold text-main">Azure DevOps</div>
                    <small class="text-muted">Public Repositories</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CORE FEATURES -->
<section class="py-5" id="features">
    <div class="container">
        
        <!-- Section Header -->
        <div class="text-center mx-auto mb-5" style="max-width: 650px;">
            <h2 class="fw-bold text-main mb-2">
                Core Features
            </h2>
            <p class="text-muted">
                Essential capabilities designed to identify exposed credentials and analyze CI/CD pipelines.
            </p>
        </div>

        <!-- Features Grid -->
        <div class="row g-4">
            
            <!-- Feature 1 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border shadow-xs rounded-3 p-4">
                    <div class="mb-3 text-primary fs-3">
                        <i class="bi bi-key"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">Secret Detection</h5>
                    <p class="text-muted mb-0 small" style="line-height: 1.6;">
                        Scans code for common credentials including AWS access keys, Stripe tokens, database connection strings, and passwords using regular expression rules.
                    </p>
                </div>
            </div>

            <!-- Feature 2 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border shadow-xs rounded-3 p-4">
                    <div class="mb-3 text-info fs-3">
                        <i class="bi bi-diagram-3"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">CI/CD Pipeline Analysis</h5>
                    <p class="text-muted mb-0 small" style="line-height: 1.6;">
                        Detects and inspects configuration files for GitHub Actions, GitLab CI, and Azure Pipelines to identify configured steps and potential exposure points.
                    </p>
                </div>
            </div>

            <!-- Feature 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border shadow-xs rounded-3 p-4">
                    <div class="mb-3 text-success fs-3">
                        <i class="bi bi-lightning-charge"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">Fast Shallow Scanning</h5>
                    <p class="text-muted mb-0 small" style="line-height: 1.6;">
                        Performs single-branch depth-1 git clones to scan the current state quickly without downloading full Git histories.
                    </p>
                </div>
            </div>

            <!-- Feature 4 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border shadow-xs rounded-3 p-4">
                    <div class="mb-3 text-danger fs-3">
                        <i class="bi bi-file-earmark-pdf"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">PDF Report Export</h5>
                    <p class="text-muted mb-0 small" style="line-height: 1.6;">
                        Generates clean PDF reports containing findings, severity levels, affected file paths, and execution timestamps for audit records.
                    </p>
                </div>
            </div>

            <!-- Feature 5 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border shadow-xs rounded-3 p-4">
                    <div class="mb-3 text-warning fs-3">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">Security Analytics</h5>
                    <p class="text-muted mb-0 small" style="line-height: 1.6;">
                        Provides aggregated metrics, vulnerability breakdowns by severity rating, and historical scan tracking.
                    </p>
                </div>
            </div>

            <!-- Feature 6 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border shadow-xs rounded-3 p-4">
                    <div class="mb-3 text-secondary fs-3">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">User Authentication</h5>
                    <p class="text-muted mb-0 small" style="line-height: 1.6;">
                        Standard registration and login with cookie authentication and hashed passwords to manage personal repositories separately.
                    </p>
                </div>
            </div>

        </div>

    </div>
</section>

<!-- HOW IT WORKS -->
<section class="py-5 bg-subtle border-top border-bottom" id="how-it-works">
    <div class="container">
        
        <div class="text-center mx-auto mb-5" style="max-width: 650px;">
            <h2 class="fw-bold text-main mb-2">
                How It Works
            </h2>
            <p class="text-muted">
                Scan any public Git repository in three simple steps.
            </p>
        </div>

        <div class="row g-4 justify-content-center">
            
            <!-- Step 1 -->
            <div class="col-md-4">
                <div class="card h-100 border shadow-xs rounded-3 p-4 text-center bg-white">
                    <div class="mx-auto mb-3 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                        1
                    </div>
                    <h5 class="fw-bold text-main mb-2">Add Repository</h5>
                    <p class="text-muted small mb-0">
                        Paste the public Git repository URL from GitHub, GitLab, Bitbucket, or Azure DevOps.
                    </p>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="col-md-4">
                <div class="card h-100 border shadow-xs rounded-3 p-4 text-center bg-white">
                    <div class="mx-auto mb-3 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                        2
                    </div>
                    <h5 class="fw-bold text-main mb-2">Run Scan</h5>
                    <p class="text-muted small mb-0">
                        Click "Scan Repository" to run pattern-matching rules and pipeline detection against the source files.
                    </p>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="col-md-4">
                <div class="card h-100 border shadow-xs rounded-3 p-4 text-center bg-white">
                    <div class="mx-auto mb-3 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                        3
                    </div>
                    <h5 class="fw-bold text-main mb-2">Review & Export</h5>
                    <p class="text-muted small mb-0">
                        Review detected findings, examine line numbers, and download the scan report as a PDF.
                    </p>
                </div>
            </div>

        </div>

    </div>
</section>

<!-- CALL TO ACTION -->
<section class="py-5">
    <div class="container">
        <div class="card border shadow-sm rounded-4 p-4 p-md-5 text-center bg-white">
            <div class="mx-auto" style="max-width: 600px;">
                <h3 class="fw-bold mb-2 text-dark">
                    Ready to Scan Your Repository?
                </h3>
                <p class="text-muted mb-4">
                    Create a free account or sign in to start scanning your repositories.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn btn-primary px-4 py-2.5 rounded-3 fw-semibold">
                        Create Account
                    </a>
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-secondary px-4 py-2.5 rounded-3 fw-semibold">
                        Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

