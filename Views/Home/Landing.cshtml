@{
    ViewData["Title"] = "DeployGuard - Source Code & Secret Scanner";
    ViewData["HideFooter"] = true;
}

<!-- HERO SECTION -->
<section class="landing-hero py-5 py-lg-6 position-relative overflow-hidden">
    <div class="container py-3">
        <div class="row align-items-center g-5">
            
            <!-- Left Column: Copy & CTAs -->
            <div class="col-lg-6">
                
                <!-- Badge (Cleaned of cyber buzzwords) -->
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary-subtle text-primary border border-primary-subtle mb-3 fs-6 fw-medium shadow-sm">
                    <img src="~/images/logo.png" alt="DeployGuard Logo" width="20" height="20" class="rounded-circle shadow-xs" />
                    <span>Automated Secret Detection & Pipeline Security</span>
                </div>

                <!-- Main Heading -->
                <h1 class="display-4 fw-extrabold text-main mb-3 lh-sm tracking-tight">
                    Detect Secrets & Secure Pipelines <span class="text-gradient">Before You Deploy</span>
                </h1>

                <!-- Subtitle -->
                <p class="lead text-muted mb-4 fs-5" style="line-height: 1.6;">
                    DeployGuard continuously scans repositories for exposed API tokens, database credentials, and CI/CD pipeline vulnerabilities in seconds.
                </p>

                <!-- Actions -->
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn btn-primary btn-lg px-4 py-3 rounded-3 shadow d-inline-flex align-items-center gap-2 fw-semibold hero-cta-btn">
                        <span>Get Started Free</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-secondary btn-lg px-4 py-3 rounded-3 fw-semibold d-inline-flex align-items-center gap-2">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Sign In</span>
                    </a>
                </div>

                <!-- Trust Points -->
                <div class="d-flex flex-wrap gap-4 text-muted small pt-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span>Zero Data Retention</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span>Automated Sandboxed Scans</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span>PDF Audit Reports</span>
                    </div>
                </div>

            </div>

            <!-- Right Column: Interactive Live Security Scanner (Always Clean White Background) -->
            <div class="col-lg-6">
                <div class="landing-preview-card border shadow-lg rounded-4 overflow-hidden position-relative scanner-white-container">
                    
                    <!-- Terminal / Window Header (Light styling) -->
                    <div class="preview-header px-4 py-3 d-flex align-items-center justify-content-between border-bottom" style="background-color: #f8fafc; border-color: #e2e8f0 !important;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="dot bg-danger rounded-circle d-inline-block" style="width: 11px; height: 11px;"></span>
                            <span class="dot bg-warning rounded-circle d-inline-block" style="width: 11px; height: 11px;"></span>
                            <span class="dot bg-success rounded-circle d-inline-block" style="width: 11px; height: 11px;"></span>
                            <span class="small text-secondary ms-2 font-monospace fw-semibold" style="font-size: 0.82rem;">deployguard-cli</span>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small fw-semibold">
                            <i class="bi bi-check-circle-fill me-1"></i> Scan Completed
                        </span>
                    </div>

                    <!-- Terminal Content (Always Pure White Background) -->
                    <div class="preview-body p-4 font-monospace" style="background-color: #ffffff; color: #1e293b;">
                        <div class="mb-3 text-muted small pb-2 border-bottom" style="border-color: #f1f5f9 !important;">
                            <span class="text-primary fw-bold">$</span> <span class="text-dark fw-semibold">deployguard scan https://github.com/company/core-service --deep</span>
                        </div>

                        <!-- Scan Metrics -->
                        <div class="row g-2 mb-3 small">
                            <div class="col-6 col-md-3">
                                <div class="p-2 rounded text-center border" style="background-color: #f8fafc; border-color: #e2e8f0 !important;">
                                    <div class="text-muted" style="font-size: 0.72rem; text-transform: uppercase;">Files</div>
                                    <div class="fw-bold text-dark fs-6">142</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2 rounded text-center border" style="background-color: #f8fafc; border-color: #e2e8f0 !important;">
                                    <div class="text-muted" style="font-size: 0.72rem; text-transform: uppercase;">Duration</div>
                                    <div class="fw-bold text-dark fs-6">1.24s</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2 rounded text-center border" style="background-color: #f8fafc; border-color: #e2e8f0 !important;">
                                    <div class="text-muted" style="font-size: 0.72rem; text-transform: uppercase;">Status</div>
                                    <div class="fw-bold text-success fs-6">Cleaned</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2 rounded text-center border" style="background-color: #fef2f2; border-color: #fecaca !important;">
                                    <div class="text-muted" style="font-size: 0.72rem; text-transform: uppercase;">Risk</div>
                                    <div class="fw-bold text-danger fs-6">Critical</div>
                                </div>
                            </div>
                        </div>

                        <!-- Live Findings Preview -->
                        <div class="findings-stream small">
                            <div class="p-2 rounded mb-2 border d-flex align-items-center justify-content-between" style="background-color: #fff1f2; border-color: #fecdd3 !important;">
                                <div>
                                    <span class="badge bg-danger me-1">CRITICAL</span>
                                    <span class="text-dark fw-medium">AWS Access Key ID in <code style="color: #be123c; background-color: #ffe4e6; padding: 1px 4px; border-radius: 3px;">src/config.json:14</code></span>
                                </div>
                                <span class="text-muted font-monospace" style="font-size: 0.75rem;">AKIA...4X9Q</span>
                            </div>

                            <div class="p-2 rounded mb-2 border d-flex align-items-center justify-content-between" style="background-color: #fffbeb; border-color: #fde68a !important;">
                                <div>
                                    <span class="badge bg-warning text-dark me-1">HIGH</span>
                                    <span class="text-dark fw-medium">Database Connection String in <code style="color: #b45309; background-color: #fef3c7; padding: 1px 4px; border-radius: 3px;">.env.staging:4</code></span>
                                </div>
                                <span class="text-muted font-monospace" style="font-size: 0.75rem;">postgres://...</span>
                            </div>

                            <div class="p-2 rounded border d-flex align-items-center justify-content-between" style="background-color: #f0f9ff; border-color: #bae6fd !important;">
                                <div>
                                    <span class="badge bg-info text-dark me-1">INFO</span>
                                    <span class="text-dark fw-medium">CI/CD Pipeline: GitHub Actions detected in <code style="color: #0369a1; background-color: #e0f2fe; padding: 1px 4px; border-radius: 3px;">.github/workflows/deploy.yml</code></span>
                                </div>
                                <i class="bi bi-arrow-repeat text-info"></i>
                            </div>
                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>
</section>

<!-- GIT PROVIDERS / INTEGRATIONS SECTION -->
<section class="py-5 border-top border-bottom bg-subtle" id="integrations">
    <div class="container">
        <div class="text-center max-w-700 mx-auto mb-4">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill mb-2 fw-medium">
                Supported Platforms
            </span>
            <h2 class="h3 fw-bold text-main mb-2">Integrated with Your Favorite Git Providers</h2>
            <p class="text-muted small mb-0">Connect any public repository with zero configuration or complex webhook setups.</p>
        </div>

        <div class="row g-3 justify-content-center pt-2">
            <div class="col-6 col-md-3">
                <div class="p-3 bg-card rounded-4 border text-center shadow-sm h-100 d-flex flex-column align-items-center justify-content-center gap-2 hover-lift transition-all">
                    <i class="bi bi-github fs-2 text-dark"></i>
                    <div class="fw-bold text-main">GitHub</div>
                    <small class="text-muted">Repos & Actions</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 bg-card rounded-4 border text-center shadow-sm h-100 d-flex flex-column align-items-center justify-content-center gap-2 hover-lift transition-all">
                    <i class="bi bi-gitlab fs-2 text-warning"></i>
                    <div class="fw-bold text-main">GitLab</div>
                    <small class="text-muted">Repos & GitLab CI</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 bg-card rounded-4 border text-center shadow-sm h-100 d-flex flex-column align-items-center justify-content-center gap-2 hover-lift transition-all">
                    <i class="bi bi-git fs-2 text-primary"></i>
                    <div class="fw-bold text-main">Bitbucket</div>
                    <small class="text-muted">Cloud & Pipelines</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 bg-card rounded-4 border text-center shadow-sm h-100 d-flex flex-column align-items-center justify-content-center gap-2 hover-lift transition-all">
                    <i class="bi bi-microsoft fs-2 text-info"></i>
                    <div class="fw-bold text-main">Azure DevOps</div>
                    <small class="text-muted">Pipelines & Repos</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CORE FEATURES GRID -->
<section class="py-5 py-lg-6" id="features">
    <div class="container">
        
        <!-- Section Header -->
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill mb-2 fw-medium">
                Security Features
            </span>
            <h2 class="display-6 fw-bold text-main mb-3">
                Everything You Need to Prevent Secret Leaks
            </h2>
            <p class="text-muted fs-5">
                Built specifically for modern development teams to catch credentials, tokens, and insecure configs before production releases.
            </p>
        </div>

        <!-- Features Row -->
        <div class="row g-4">
            
            <!-- Feature 1 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card transition-all">
                    <div class="feature-icon-wrapper mb-3 bg-primary-subtle text-primary rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-key-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">Automated Secret Scanner</h5>
                    <p class="text-muted mb-0">
                        Scan codebases for AWS keys, Stripe tokens, private SSH keys, OpenAI API keys, database strings, and passwords using optimized regex rules.
                    </p>
                </div>
            </div>

            <!-- Feature 2 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card transition-all">
                    <div class="feature-icon-wrapper mb-3 bg-info-subtle text-info rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-diagram-3-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">CI/CD Pipeline Analysis</h5>
                    <p class="text-muted mb-0">
                        Automatically inspect GitHub Actions, GitLab CI, and Azure Pipelines files for unsafe steps, exposed environment variables, and branch rules.
                    </p>
                </div>
            </div>

            <!-- Feature 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card transition-all">
                    <div class="feature-icon-wrapper mb-3 bg-success-subtle text-success rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-lightning-charge-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">Fast Sandboxed Scans</h5>
                    <p class="text-muted mb-0">
                        Clones shallow repository snapshots inside isolated execution sandboxes and securely wipes all code immediately after inspection.
                    </p>
                </div>
            </div>

            <!-- Feature 4 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card transition-all">
                    <div class="feature-icon-wrapper mb-3 bg-danger-subtle text-danger rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-file-earmark-pdf-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">PDF Audit Reports</h5>
                    <p class="text-muted mb-0">
                        Generate comprehensive PDF security reports with severity risk ratings, finding locations, and compliance audits for records.
                    </p>
                </div>
            </div>

            <!-- Feature 5 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card transition-all">
                    <div class="feature-icon-wrapper mb-3 bg-warning-subtle text-warning rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-shield-lock-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">Security Analytics</h5>
                    <p class="text-muted mb-0">
                        Centralized platform dashboard to monitor cross-repository risk scores, top secret categories, and historical scan activity.
                    </p>
                </div>
            </div>

            <!-- Feature 6 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card transition-all">
                    <div class="feature-icon-wrapper mb-3 bg-purple-subtle text-purple rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-google fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-main mb-2">Single Sign-On & Auth</h5>
                    <p class="text-muted mb-0">
                        One-click Google Firebase Sign-In, secure bcrypt password hashing, and encrypted cookie sessions for effortless team onboarding.
                    </p>
                </div>
            </div>

        </div>

    </div>
</section>

<!-- HOW IT WORKS SECTION -->
<section class="py-5 py-lg-6" id="how-it-works">
    <div class="container">
        
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill mb-2 fw-medium">
                Simple 3-Step Workflow
            </span>
            <h2 class="display-6 fw-bold text-main mb-3">
                How DeployGuard Works
            </h2>
            <p class="text-muted fs-5">
                Protecting your codebase takes less than 30 seconds with no complex agent installations required.
            </p>
        </div>

        <div class="row g-4 justify-content-center">
            
            <!-- Step 1 -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-card">
                    <div class="step-badge mx-auto mb-3 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 44px; height: 44px;">
                        1
                    </div>
                    <h5 class="fw-bold text-main mb-2">Connect Repository</h5>
                    <p class="text-muted small mb-0">
                        Add any public repository URL from GitHub, GitLab, Bitbucket, or Azure DevOps.
                    </p>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-card">
                    <div class="step-badge mx-auto mb-3 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 44px; height: 44px;">
                        2
                    </div>
                    <h5 class="fw-bold text-main mb-2">Run Automated Scan</h5>
                    <p class="text-muted small mb-0">
                        DeployGuard inspects commit files and CI/CD pipelines across dozens of active secret detection rules.
                    </p>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-card">
                    <div class="step-badge mx-auto mb-3 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 44px; height: 44px;">
                        3
                    </div>
                    <h5 class="fw-bold text-main mb-2">Remediate & Export</h5>
                    <p class="text-muted small mb-0">
                        View exact line numbers, severity breakdown, and download audit-ready executive PDF reports.
                    </p>
                </div>
            </div>

        </div>

    </div>
</section>

